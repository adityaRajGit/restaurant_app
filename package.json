{
    "name": "restaurantapp",
    "version": "1.0.0",
    "description": "Restaurant app backend",
    "main": "restaurant-app.js",
    "private": true,
    "keywords": [],
    "author": "Aditya Raj",
    "license": "ISC",
    "scripts": {
        "start": "cross-env BABEL_DISABLE_CACHE=1 NODE_ENV=development nodemon restaurant-app.js",
        "build": "npm run build:server",
        "build:server": "cross-env NODE_ENV=production babel --delete-dir-on-start --out-dir dist --copy-files --ignore \"**/__tests__/**,**/__mocks__/**\" --no-copy-ignored src",
        "start:prod": "cross-env NODE_ENV=production node restaurant-app.js",
        "build:all": "npm run clean && npm run build:server",
        "clean": "rimraf dist",
        "slate": "rimraf node_modules && npm install",
        "test": "jest",
        "test:watch": "jest --watch",
        "swagger": "node swagger/swagger.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.20.2",
        "chalk": "^3.0.0",
        "cloudinary": "^1.30.1",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "dotenv": "^8.2.0",
        "email-validator": "^2.0.4",
        "express": "^4.18.2",
        "express-session": "^1.18.1",
        "google-auth-library": "^10.1.0",
        "jsonwebtoken": "^8.5.1",
        "lodash": "^4.17.21",
        "moment": "^2.29.4",
        "mongoose": "^8.6.1",
        "multer": "^1.4.5-lts.1",
        "multer-storage-cloudinary": "^4.0.0",
        "nodemailer": "^6.7.2",
        "replaceall": "^0.1.6",
        "swagger-autogen": "^2.23.7",
        "swagger-ui-express": "^4.6.0",
        "uuid": "^11.0.5",
        "validator": "^13.7.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.20.7",
        "@babel/core": "^7.20.12",
        "@babel/preset-env": "^7.20.2",
        "@babel/register": "^7.25.9",
        "jest": "^30.0.4",
        "nodemon": "^1.19.4",
        "rimraf": "^5.0.5",
        "supertest": "^7.1.3"
    }
}
