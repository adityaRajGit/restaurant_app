{
  "info": {
    "title": "Restaurant App API",
    "description": "Backend API for the restaurant app — menu and orders",
    "version": "0.1.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": ["http", "https"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer <token>"
    }
  }
}
